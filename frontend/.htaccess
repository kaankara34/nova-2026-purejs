RewriteRule ^east-west\.html$ /en/the-residences-east-west.html [R=301,L]
RewriteRule ^east-west$ /en/the-residences-east-west.html [R=301,L]
RewriteRule ^the-apartments-tac\.html$ /en/the-apartments-tac.html [R=301,L]
RewriteRule ^the-apartments-tac$ /en/the-apartments-tac.html [R=301,L]
