RewriteEngine On
RewriteBase /

# Default language is Turkish
RewriteRule ^$ /tr/ [R=301,L]
RewriteRule ^index\.html$ /tr/ [R=301,L]

# Legacy root-level English URLs -> /en/ (single hop)
RewriteRule ^projects\.html$ /en/projects.html [R=301,L]
RewriteRule ^projects$ /en/projects.html [R=301,L]
RewriteRule ^about\.html$ /en/about.html [R=301,L]
RewriteRule ^about$ /en/about.html [R=301,L]
RewriteRule ^contact\.html$ /en/contact.html [R=301,L]
