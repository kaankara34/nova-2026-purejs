    { "source": "/bahar-residence", "destination": "/bahar-residence.html" },
    { "source": "/mehtap-residence", "destination": "/mehtap-residence.html" },
    { "source": "/dogan-residence", "destination": "/dogan-residence.html" },
    { "source": "/mercan-bosphorus", "destination": "/mercan-bosphorus.html" },
    { "source": "/nisbetiye-on", "destination": "/nisbetiye-on.html" },
    { "source": "/falcon-plaza", "destination": "/falcon-plaza.html" },
    { "source": "/falcon-logistic", "destination": "/falcon-logistic.html" },
