{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/east-west", "destination": "/east-west.html" },
    { "source": "/marti-residence", "destination": "/marti-residence.html" },
    { "source": "/projects", "destination": "/projects.html" }
  ],
  "headers": [
    {
      "source": "**/*.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
